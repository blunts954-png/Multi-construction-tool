# ============================================
# DATABASE CONFIGURATION
# ============================================
# For local development, you can use SQLite (default) or PostgreSQL
# For production, use PostgreSQL, MySQL, or other supported databases

# SQLite (default for development)
DATABASE_URL="file:./dev.db"

# PostgreSQL (recommended for production)
# DATABASE_URL="postgresql://username:password@localhost:5432/construction_saas?schema=public"

# MySQL
# DATABASE_URL="mysql://username:password@localhost:3306/construction_saas"

# Supabase PostgreSQL
# DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres"

# Railway PostgreSQL
# DATABASE_URL="postgresql://postgres:[PASSWORD]@[HOST]:[PORT]/railway"


# ============================================
# JWT AUTHENTICATION
# ============================================
# Generate a secure random string for production (e.g., openssl rand -base64 32)
JWT_SECRET="your-super-secret-jwt-key-change-this-in-production"
JWT_EXPIRES_IN="7d"


# ============================================
# OPENAI API (Required for AI features)
# ============================================
# Get your API key from https://platform.openai.com/api-keys
OPENAI_API_KEY="sk-your-openai-api-key"


# ============================================
# QUICKBOOKS INTEGRATION (Optional)
# ============================================
# Get credentials from https://developer.intuit.com
QB_CLIENT_ID="your-quickbooks-client-id"
QB_CLIENT_SECRET="your-quickbooks-client-secret"
QB_REDIRECT_URI="http://localhost:3000/api/integrations/quickbooks/callback"
QB_ENVIRONMENT="sandbox"  # Use "production" for live QuickBooks

# Production QuickBooks
# QB_REDIRECT_URI="https://yourdomain.com/api/integrations/quickbooks/callback"
# QB_ENVIRONMENT="production"


# ============================================
# FILE STORAGE
# ============================================
# Local storage path (default)
UPLOAD_DIR="./uploads"

# AWS S3 (optional for production)
# AWS_ACCESS_KEY_ID="your-aws-access-key"
# AWS_SECRET_ACCESS_KEY="your-aws-secret-key"
# AWS_REGION="us-east-1"
# AWS_S3_BUCKET="construction-saas-files"

# Cloudflare R2 (alternative to S3)
# R2_ACCESS_KEY_ID="your-r2-access-key"
# R2_SECRET_ACCESS_KEY="your-r2-secret-key"
# R2_ENDPOINT="https://[account-id].r2.cloudflarestorage.com"
# R2_BUCKET="construction-files"


# ============================================
# EMAIL INTEGRATION (Optional)
# ============================================
# Gmail OAuth
# GMAIL_CLIENT_ID="your-gmail-client-id"
# GMAIL_CLIENT_SECRET="your-gmail-client-secret"
# GMAIL_REDIRECT_URI="http://localhost:3000/api/integrations/gmail/callback"

# Microsoft 365 OAuth
# MS365_CLIENT_ID="your-microsoft-client-id"
# MS365_CLIENT_SECRET="your-microsoft-client-secret"
# MS365_REDIRECT_URI="http://localhost:3000/api/integrations/microsoft/callback"


# ============================================
# APPLICATION CONFIGURATION
# ============================================
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="Construction SaaS"
NODE_ENV="development"

# Production
# NEXT_PUBLIC_APP_URL="https://yourdomain.com"
# NODE_ENV="production"


# ============================================
# OPTIONAL: ANALYTICS & MONITORING
# ============================================
# Google Analytics
# NEXT_PUBLIC_GA_ID="G-XXXXXXXXXX"

# Sentry Error Tracking
# SENTRY_DSN="https://[key]@[org].ingest.sentry.io/[project]"

# Posthog Analytics
# NEXT_PUBLIC_POSTHOG_KEY="phc_your_key"
# NEXT_PUBLIC_POSTHOG_HOST="https://app.posthog.com"


# ============================================
# OPTIONAL: RATE LIMITING & SECURITY
# ============================================
# Redis (for rate limiting and caching)
# REDIS_URL="redis://localhost:6379"

# Upstash Redis (serverless option)
# UPSTASH_REDIS_REST_URL="https://[endpoint].upstash.io"
# UPSTASH_REDIS_REST_TOKEN="your-token"


# ============================================
# OPTIONAL: NOTIFICATIONS
# ============================================
# Twilio (for SMS notifications)
# TWILIO_ACCOUNT_SID="your-account-sid"
# TWILIO_AUTH_TOKEN="your-auth-token"
# TWILIO_PHONE_NUMBER="+1234567890"

# SendGrid (for email notifications)
# SENDGRID_API_KEY="SG.your-api-key"
# SENDGRID_FROM_EMAIL="noreply@yourdomain.com"
